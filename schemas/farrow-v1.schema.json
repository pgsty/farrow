{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pigsty.io/schemas/farrow-v1.schema.json",
  "title": "Farrow configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "network", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "name": { "$ref": "#/$defs/dnsLabel" },
    "arch": { "enum": ["native"] },
    "network": { "$ref": "#/$defs/network" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "ssh": { "$ref": "#/$defs/ssh" },
    "storage": { "$ref": "#/$defs/storage" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "size": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:B|KiB|MiB|GiB|TiB|KB|MB|GB|TB)$"
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(?:ns|us|µs|ms|s|m|h)(?:[0-9]+(?:ns|us|µs|ms|s|m|h))*$"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["user", "private"] },
        "cidr": { "type": "string", "pattern": "^(10\\.(?:[0-9]{1,3}\\.){2}|172\\.(?:1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.|192\\.168\\.[0-9]{1,3}\\.)0/24$" },
        "host_address": { "type": "string", "format": "ipv4" },
        "dhcp_end": { "type": "string", "format": "ipv4" }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "cpus": { "type": "integer", "minimum": 1, "maximum": 256 },
        "memory": { "$ref": "#/$defs/size" },
        "root_disk": { "$ref": "#/$defs/size" }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": { "type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$" },
        "wait_timeout": { "$ref": "#/$defs/duration" }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data_root": { "type": "string", "pattern": "^/" }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "mount"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "size": { "$ref": "#/$defs/size" },
        "mount": { "type": "string", "pattern": "^/" },
        "filesystem": { "enum": ["auto", "xfs", "ext4"] },
        "persistent": { "type": "boolean" }
      }
    },
    "share": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "guest"],
      "properties": {
        "host": { "type": "string", "pattern": "^/[^\\u0000\\r\\n]+$" },
        "guest": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" },
        "readonly": { "type": "boolean", "default": true }
      }
    },
    "forward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "guest"],
      "properties": {
        "bind": { "type": "string", "format": "ipv4" },
        "host": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "guest": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["tcp"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/dnsLabel" },
        "control": { "type": "boolean" },
        "address": { "type": "string", "format": "ipv4" },
        "host_aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "image": { "type": "string", "minLength": 1 },
        "cpus": { "type": "integer", "minimum": 1, "maximum": 256 },
        "memory": { "$ref": "#/$defs/size" },
        "root_disk": { "$ref": "#/$defs/size" },
        "disks": {
          "type": "array",
          "items": { "$ref": "#/$defs/disk" }
        },
        "shares": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/share" }
        },
        "forwards": {
          "type": "array",
          "items": { "$ref": "#/$defs/forward" }
        }
      }
    }
  }
}
