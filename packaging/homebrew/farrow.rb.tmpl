# typed: strict
# frozen_string_literal: true

# Farrow installs the unprivileged native QEMU development-VM runtime.
class Farrow < Formula
  desc "Native Go/QEMU runtime for Pigsty development VMs"
  homepage "https://github.com/pgsty/farrow"
  version "@VERSION@"
  license "Apache-2.0"

  depends_on "qemu"

  on_macos do
    on_arm do
      url "@BASE_URL@/farrow_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@DARWIN_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/farrow_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@DARWIN_AMD64_SHA@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/farrow_@VERSION@_linux_arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/farrow_@VERSION@_linux_amd64.tar.gz"
      sha256 "@LINUX_AMD64_SHA@"
    end
  end

  def install
    bin.install "bin/farrow"
    libexec.install "bin/farrow-hosts-helper"
    doc.install "README.md", "THIRD_PARTY_LICENSES.md"
    doc.install "third_party/licenses"
  end

  def caveats
    <<~EOS
      Prepare the host once, then start the lab:
        farrow setup
        farrow up

      For a fixed-IP private lab, run these two commands in an empty directory:
        farrow setup meta    # one node; or: farrow setup full
        farrow up

      Setup is idempotent. It installs or reuses the private host network,
      downloads and verifies Farrow's pinned socket_vmnet asset on macOS, and
      asks for administrator access only when the host transaction needs it.
    EOS
  end

  test do
    assert_match "farrow #{version}", shell_output("#{bin}/farrow version")
  end
end
