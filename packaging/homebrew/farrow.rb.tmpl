# typed: strict
# frozen_string_literal: true

# Farrow installs the unprivileged native QEMU development-VM runtime.
class Farrow < Formula
  desc "Native Go/QEMU runtime for Pigsty development VMs"
  homepage "https://github.com/pgsty/farrow"
  version "@VERSION@"
  license "Apache-2.0"

  depends_on "qemu"

  on_macos do
    on_arm do
      url "@BASE_URL@/farrow_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@DARWIN_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/farrow_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@DARWIN_AMD64_SHA@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/farrow_@VERSION@_linux_arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/farrow_@VERSION@_linux_amd64.tar.gz"
      sha256 "@LINUX_AMD64_SHA@"
    end
  end

  def install
    bin.install "bin/farrow"
    libexec.install "bin/farrow-hosts-helper"
    doc.install "README.md"
    doc.install "licenses"
  end

  def caveats
    <<~EOS
      Start your first VM from a terminal:
        farrow up
        farrow ssh

      Up reuses your inventory or current lab, and creates a one-node
      farrow.yml when neither exists. It prepares the host when needed and
      asks for administrator access at the privileged step.
      Use farrow init full to customize a four-node lab before starting it.
      For unattended preparation, run farrow setup --yes before farrow up.
    EOS
  end

  test do
    assert_match "farrow #{version}", shell_output("#{bin}/farrow version")
  end
end
