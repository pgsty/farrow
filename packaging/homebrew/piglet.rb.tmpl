# typed: strict
# frozen_string_literal: true

# Piglet installs the unprivileged native QEMU development-VM runtime.
class Piglet < Formula
  desc "Native Go/QEMU runtime for Pigsty development VMs"
  homepage "https://github.com/pgsty/piglet"
  version "@VERSION@"
  license "Apache-2.0"

  depends_on "qemu"

  on_macos do
    on_arm do
      url "@BASE_URL@/piglet_@VERSION@_darwin_arm64.tar.gz"
      sha256 "@DARWIN_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/piglet_@VERSION@_darwin_amd64.tar.gz"
      sha256 "@DARWIN_AMD64_SHA@"
    end
  end

  on_linux do
    on_arm do
      url "@BASE_URL@/piglet_@VERSION@_linux_arm64.tar.gz"
      sha256 "@LINUX_ARM64_SHA@"
    end
    on_intel do
      url "@BASE_URL@/piglet_@VERSION@_linux_amd64.tar.gz"
      sha256 "@LINUX_AMD64_SHA@"
    end
  end

  def install
    bin.install "bin/piglet"
    bin.install "bin/pigsty-vm"
    libexec.install "bin/piglet-hosts-helper"
    doc.install "README.md", "THIRD_PARTY_LICENSES.md"
    doc.install Dir["docs/*"]
    doc.install "third_party/licenses"
    pkgshare.install "schemas"
  end

  def caveats
    <<~EOS
      This development formula installs only the unprivileged Piglet CLI.
      It does not install or run socket_vmnet or any root-owned network helper.

      Private-project `piglet hosts ... --yes` requires an explicit root-owned
      copy of the narrow helper. After reviewing that boundary, install it with:
        sudo install -d -o root -g 0 -m 0755 /opt/piglet/libexec
        sudo install -o root -g 0 -m 0755 #{libexec}/piglet-hosts-helper /opt/piglet/libexec/piglet-hosts-helper
    EOS
  end

  test do
    assert_match "piglet #{version}", shell_output("#{bin}/piglet version")
  end
end
